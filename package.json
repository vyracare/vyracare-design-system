{
  "name": "@vyracare/design-system",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "private": false,
  "description": "Vyracare Design System (Angular) - tokens + componentes + storybook.",
  "scripts": {
    "build": "ng run design-system:build",
    "playground:build": "ng run playground:build",
    "prepare": "husky",
    "start": "ng serve playground --port 4205",
    "test": "jest --coverage",
    "storybook": "ng run design-system:storybook",
    "storybook:build": "ng run design-system:build-storybook",
    "storybook:serve": "http-server dist/storybook -p 6006 -c-1 --silent",
    "test-storybook": "test-storybook --config-dir libs/vyracare-ui/.storybook --url http://127.0.0.1:6006 --maxWorkers=2",
    "test-storybook:ci": "node scripts/run-storybook-tests.mjs",
    "visual-tests": "chromatic --exit-once-uploaded --storybook-build-dir dist/storybook",
    "version:ci": "node scripts/bump-ci-version.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "sideEffects": [
    "./apps/playground/src/polyfills.ts"
  ],
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "bootstrap-icons": "^1.11.3",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.2202.6",
    "@angular-devkit/build-angular": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-browser-dynamic": "22.2.6",
    "@angular/router": "22.2.6",
    "@babel/core": "8.0.5",
    "@changesets/cli": "^2.28.1",
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/angular": "10.6.7",
    "@storybook/test-runner": "^0.24.2",
    "@types/jest": "30.0.0",
    "@types/node": "^20.17.19",
    "bootstrap-icons": "^1.11.3",
    "chromatic": "^15.2.0",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "17.0.3",
    "ng-packagr": "22.2.6",
    "storybook": "10.6.7",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "zone.js": "~0.15.0"
  }
}
